{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm with-env turbo run dev",
    "dev:server": "pnpm with-env turbo run dev --filter=server",
    "dev:web": "pnpm with-env turbo run dev --filter=web",
    "build": "pnpm with-env turbo run build",
    "build:server": "pnpm with-env turbo run build --filter=server",
    "build:web": "pnpm with-env turbo run build --filter=web",
    "start": "turbo run start",
    "start:server": "turbo run start --filter=server",
    "start:web": "turbo run start --filter=web",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "with-env": "dotenv -e .env --"
  },
  "devDependencies": {
    "@dhwani/eslint-config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "latest"
  }
}